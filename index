        </article>

        <!-- Accommodations -->
        <article class="category-preview-card">
            <div class="card-image-box">
                <img src="cartagena.jpg" alt="Luxury Accommodations Cartagena" loading="lazy">
            </div>
            <div class="card-info-box">
                <h3 data-es="Accommodations" data-en="Accommodations">Accommodations</h3>
